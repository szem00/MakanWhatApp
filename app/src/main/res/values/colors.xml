<resources>
    <!-- The Kopi coin look; ui/theme/Color.kt holds the same colours for the app's screens. -->
    <color name="ic_launcher_background">#2A1A10</color>

    <!-- Shown before the first screen draws, so opening the app doesn't flash white. -->
    <color name="window_background">#FBF4E8</color>

    <!-- The widget's System look, which values-night switches to the dark colours.
         Its Light and Dark looks use the suffixed colours directly, whatever the phone's mode. -->
    <color name="widget_surface">@color/widget_surface_light</color>
    <color name="widget_on_surface">@color/widget_on_surface_light</color>
    <color name="widget_on_surface_variant">@color/widget_on_surface_variant_light</color>
    <color name="widget_accent">@color/widget_accent_light</color>
    <color name="widget_on_accent">@color/widget_on_accent_light</color>
    <color name="widget_error">@color/widget_error_light</color>

    <color name="widget_surface_light">#FBF4E8</color>
    <color name="widget_on_surface_light">#2A1A10</color>
    <color name="widget_on_surface_variant_light">#6E5846</color>
    <color name="widget_accent_light">#6B4226</color>
    <color name="widget_on_accent_light">#FFFFFF</color>
    <color name="widget_error_light">#B3261E</color>

    <color name="widget_surface_dark">#2A1A10</color>
    <color name="widget_on_surface_dark">#F3E6D2</color>
    <color name="widget_on_surface_variant_dark">#C4AE95</color>
    <color name="widget_accent_dark">#E7B24A</color>
    <color name="widget_on_accent_dark">#2A1A10</color>
    <color name="widget_error_dark">#F2B8B5</color>
</resources>
